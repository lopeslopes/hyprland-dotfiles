{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",        // Logo type: auto, builtin, small, file, etc.
        "source": "~/.config/miyabi.txt",
        "width": 30,           // Width in characters (for image logos)
        "height": 14,          // Height in characters (for image logos)
        "padding": {
                "top": 0,          // Top padding
                "left": 0,         // Left padding
                "right": 2         // Right padding
        }
        // "color": {             // Override logo colors
        //         "1": "blue",
        //         "2": "green"
        // }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "kernel",
        "uptime",
        "shell",
        "wm",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "break",
        "colors"
    ]
}
